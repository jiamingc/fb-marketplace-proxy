{% extends "layout.html.jinja" %}
{% set active_nav_entry = "listing_create" %}
{% block title %}New Listing{% endblock %}
{% block content %}
	<form action="/listing/create" method="post" enctype="multipart/form-data">
		<label for="title">Title</label>
		<input type="text" name="title" id="title" required />

		<label for="description">Description</label>
		<textarea name="description" id="description" required></textarea>

		<label for="price">Price</label>
		<input type="number" name="price" id="price" min="0" required />

		<label for="condition">Condition</label>
		<select name="condition" id="condition" required>
			<option value=""></option>
			<option value="new">New</option>
			<option value="used_like_new">Used - Like New</option>
			<option value="used_good">Used - Good</option>
			<option value="used_fair">Used - Fair</option>
		</select>

		<label for="photos">Photos</label>
		<input type="file" name="photos" id="photos" accept="image/*" multiple required />

		<input type="submit" value="Create" />
	</form>
{% endblock %}
