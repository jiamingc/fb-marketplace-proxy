{% set nav_entries = [
	("search", "/", "Search"),
	("create_listing", "/create_listing", "New Listing"),
	("your_listings", "/your_listings", "Your Listings"),
	("inbox", "/inbox", "Inbox"),
	("saved", "/saved", "Saved"),
	("settings", "/settings", "Settings"),
] -%}
<!DOCTYPE html>
<html>
	<head>
		<title>{% block title %}{% endblock %}</title>
		<style>
			nav ul {
				list-style: none;
				padding: 0;

				li {
					display: inline-block;

					a {
						color: inherit;
						text-decoration: none;
					}

					+ li::before {
						content: "|";
					}
				}

				li.active a {
					text-decoration: underline;
				}
			}

			.grid-form {
				width: 300px;
				display: grid;
				grid-template-columns: auto auto;
			}
		</style>
	</head>
	<body>
		<nav>
			<ul>
				{% for id, href, label in nav_entries %}
					<li{% if id == active_nav_entry %} class="active"{% endif %}>
						<a href="{{ href|e }}">{{ label|e }}</a>
					</li>
				{% endfor %}
			</ul>
		</nav>
		<h1>{{ self.title() }}</h1>
		{% block content required %}{% endblock %}
	</body>
</html>
