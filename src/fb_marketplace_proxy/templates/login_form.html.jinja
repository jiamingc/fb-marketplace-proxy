<!DOCTYPE html>
<html>
	<head>
		<title>Login</title>
		<style>
			form {
				width: 300px;
			}
			.field {
				display: flex;
				justify-content: space-between;
			}
		</style>
	</head>
	<body>
		<h1>Login</h1>
		<form action="login" method="POST">
			<div class="field" />
				<label for="c_user">c_user</label>
				<input type="text" name="c_user" id="c_user" required />
			</div>
			<div class="field" />
				<label for="xs">xs</label>
				<input type="text" name="xs" id="xs" required />
			</div>
			<input type="submit" value="Log In" />
		</form>
	</body>
</html>
